# PulseWrite AI Studio - Environment Configuration
# Pure Client-Side PKCE SPA: Uses a Zorveus Public Client ID with zero client secrets and zero backend proxying.

# Zorveus Public Client ID (Required for OAuth Connect Wallet flow)
VITE_ZORVEUS_CLIENT_ID=""

# Zorveus Control Plane Backend URL (Default: https://api.zorveus.com)
VITE_ZORVEUS_API_URL="https://api.zorveus.com"

# Zorveus AI Gateway Base URL (Default: https://api.zorveus.com/v1)
VITE_ZORVEUS_GATEWAY_URL="https://api.zorveus.com/v1"

# OAuth Callback Redirect URI
VITE_ZORVEUS_REDIRECT_URI="http://localhost:5173/oauth/callback"
